<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:XFitnessApp2"
             x:Class="XFitnessApp2.AdminRezervariPage">
    <StackLayout Padding="20">
        <Label Text="Toate Rezervările" FontSize="Large" HorizontalOptions="Center" />

        <ListView x:Name="AllReservationsListView">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <StackLayout Orientation="Vertical" Padding="10">
                            <Label Text="{Binding Schedule.Clasa}" FontSize="Medium" />
                            <Label Text="{Binding Schedule.Date, StringFormat='Data: {0:dd/MM/yyyy}'}" />
                            <Label Text="{Binding User.Username, StringFormat='User: {0}'}" />
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Button Text="Schedule" 
Clicked="OnBtClicked" />
    </StackLayout>
            
</ContentPage>
