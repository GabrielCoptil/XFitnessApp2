<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:XFitnessApp2"
             x:Class="XFitnessApp2.RegisterPage">
    <StackLayout Padding="20" VerticalOptions="Center">
        <Label Text="Înregistrare Utilizator" FontSize="Large" HorizontalOptions="Center" />

        <Entry x:Name="UsernameEntry" Placeholder="Username" />
        <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />
        <Picker x:Name="RolePicker" Title="Alege rolul">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Client</x:String>
                    <x:String>PT</x:String>
                    <x:String>Administrator</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>

        <Button Text="Înregistrează-te" Clicked="OnRegisterClicked" />
    </StackLayout>
</ContentPage>
