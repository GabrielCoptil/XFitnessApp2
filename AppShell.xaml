<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:local="clr-namespace:XFitnessApp2"
       x:Class="XFitnessApp2.AppShell">
    <FlyoutItem Title="Login" Route="LoginPage">
        <ShellContent ContentTemplate="{DataTemplate local:LoginPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Register" Route="RegisterPage">
        <ShellContent ContentTemplate="{DataTemplate local:RegisterPage}" />
    </FlyoutItem>
    <FlyoutItem Title="Schedule" Route="SchedulePage">
        <ShellContent ContentTemplate="{DataTemplate local:SchedulePage}" />
    </FlyoutItem>
    <FlyoutItem Title="Rezervări Admin" Route="AdminRezervariPage" IsVisible="False" x:Name="AdminReservationsFlyout">
        <ShellContent ContentTemplate="{DataTemplate local:AdminRezervariPage}" />
    </FlyoutItem>
</Shell>

