<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:XFitnessApp2"
             x:Class="XFitnessApp2.LoginPage">
    <StackLayout Padding="20" VerticalOptions="Center">
        <Label Text="Logare Utilizator" FontSize="Large" HorizontalOptions="Center" />
        <Entry x:Name="UsernameEntry" Placeholder="Username" />
        <Entry x:Name="PasswordEntry" Placeholder="Password" IsPassword="True" />
        <Button Text="Login" Clicked="OnLoginClicked" />
        <Button Text="Nu ai cont? Înregistrează-te" 
        Clicked="OnRegisterButtonClicked" />
    </StackLayout>
</ContentPage>

